# Nginx 站台範本。project-init.sh 會把下列佔位符替換後，寫入 /etc/nginx/sites-available/__DOMAIN__：
#   __DOMAIN__       網域（同時包含 www.__DOMAIN__）
#   __APP_DIR__      部署資料夾（root 為 __APP_DIR__/public）
#   __PHP_VERSION__  PHP-FPM 版本
server {
    listen 80;
    listen [::]:80;

    server_name __DOMAIN__ www.__DOMAIN__;

    root __APP_DIR__/public;
    index index.php;

    # 上傳檔案大小限制（配合圖片上傳功能）
    client_max_body_size 20M;

    # 靜態資源快取
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|woff|woff2|ttf|svg)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
        try_files $uri =404;
    }

    # Laravel 路由處理
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # PHP-FPM
    location ~ \.php$ {
        fastcgi_pass unix:/var/run/php/php__PHP_VERSION__-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 300;
    }

    # 禁止存取隱藏檔案（.env, .git 等）
    location ~ /\. {
        deny all;
    }

    # 日誌
    access_log /var/log/nginx/__DOMAIN__-access.log;
    error_log  /var/log/nginx/__DOMAIN__-error.log;
}
